{
  "id": "com.wiserone.WiserOne",
  "runtime": "org.kde.Platform",
  "runtime-version": "6.10",
  "sdk": "org.kde.Sdk",
  "command": "wiserone",
  "finish-args": [
    "--share=network",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri",
    "--talk-name=org.freedesktop.Notifications",
    "--filesystem=xdg-config",
    "--filesystem=xdg-data"
  ],
  "modules": [
    {
      "name": "wiserone",
      "buildsystem": "cmake",
      "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DBUILD_TESTING=OFF"
      ],
      "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/share/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/locale"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "./src"
        }
      ]
    }
  ]
}
