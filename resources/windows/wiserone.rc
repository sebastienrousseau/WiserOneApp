// Windows resource file for The Wiser One
#include <windows.h>

// Application icon
IDI_ICON1 ICON "wiserone.ico"

// Version information
VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,0,2,0
PRODUCTVERSION 0,0,2,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "WiserOne"
            VALUE "FileDescription", "The Wiser One - Inspirational Quotes"
            VALUE "FileVersion", "0.0.2.0"
            VALUE "InternalName", "WiserOne"
            VALUE "LegalCopyright", "Copyright (C) 2024-2026 WiserOne"
            VALUE "OriginalFilename", "WiserOne.exe"
            VALUE "ProductName", "The Wiser One"
            VALUE "ProductVersion", "0.0.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
