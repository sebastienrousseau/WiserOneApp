  <name>The Wiser One</name>
  <summary>Display inspirational quotes in your system tray</summary>
  <description>
    <p>
      The Wiser One is a lightweight system tray application that displays
      inspirational quotes throughout your day. Click the tray icon to see
      a new quote, visit the website, or quit the application.
    </p>
    <p>Features:</p>
    <ul>
      <li>Curated collection of inspirational quotes</li>
      <li>Monthly rotating quote collections</li>
      <li>Minimal system resources</li>
      <li>Supports light and dark themes</li>
      <li>Available in 15 languages</li>
    </ul>
  </description>
  <launchable type="desktop-id">com.wiserone.WiserOne.desktop</launchable>
  <url type="homepage">https://wiserone.com</url>
